-- ========== Вкладки ==========
local tabButtons = {}
local currentTab = nil

local function createTab(name, icon)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 100, 0, 36)
    btn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
    btn.Text = name
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    btn.TextSize = 14
    btn.Font = Enum.Font.Gotham
    btn.AutoButtonColor = false
    btn.Parent = titleBar
    
    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 8)
    btnCorner.Parent = btn
    
    local container = Instance.new("Frame")
    container.Size = UDim2.new(1, 0, 1, 0)
    container.BackgroundTransparency = 1
    container.Visible = false
    container.Parent = contentArea
    
    table.insert(tabButtons, {btn = btn, container = container, name = name})
    
    btn.MouseButton1Click:Connect(function()
        for _, t in ipairs(tabButtons) do
            t.container.Visible = false
            t.btn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
            t.btn.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
        container.Visible = true
        btn.BackgroundColor3 = Color3.fromRGB(168, 138, 98)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        currentTab = name
    end)
    
    return container
end

-- Расположим кнопки вкладок рядом
local function layoutTabs()
    local x = 10
    for _, tab in ipairs(tabButtons) do
        tab.btn.Position = UDim2.new(0, x, 0, 45)
        x = x + 110
    end
end

