-- ========== Функционал WalkSpeed ==========
local walkSpeedEnabled = false
local walkSpeedValue = 32 -- значение по умолчанию (стандарт 16, но слайдер до 100)
local currentCharacter = player.Character
local humanoid = currentCharacter and currentCharacter:FindFirstChild("Humanoid")

-- Следим за сменой персонажа
player.CharacterAdded:Connect(function(character)
    currentCharacter = character
    humanoid = character:WaitForChild("Humanoid")
    if walkSpeedEnabled then
        humanoid.WalkSpeed = walkSpeedValue
    end
end)

-- Функция применения скорости
local function applyWalkSpeed()
    if humanoid and walkSpeedEnabled then
        humanoid.WalkSpeed = walkSpeedValue
    end
end

